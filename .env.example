MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hanzalah_supermarket

# Initial setup only: choose a unique password before starting an empty database.
# Existing users are not changed by these values.
BOOTSTRAP_ADMIN_PASSWORD=
# Optional initial staff accounts (each password must be at least 12 characters).
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_CASHIER_PASSWORD=

# Optional isolated demo seed. Never use the business database name here.
MONGODB_DEMO_DB=hanzala_portfolio_demo
DEMO_PASSWORD=
PORT=3000
